<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <style>
        /* Define o tamanho da página A4 */
        @page { size: A4; margin: 2cm; }
        body { font-family: Arial, sans-serif; font-size: 14px; }
        
        /* Cabeçalho */
        .header { display: flex; justify-content: space-between; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 30px; }
        .logo { max-height: 60px; }
        .school-info { text-align: right; }
        
        /* Estilo do Gabarito (bolinhas) */
        .gabarito-grid { display: flex; flex-direction: column; gap: 10px; }
        .gabarito-row { display: flex; gap: 15px; align-items: center; }
        .bubble { 
            width: 25px; 
            height: 25px; 
            border: 1px solid #000; 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="header">
        {{#if logoBase64}}
            <img src="{{logoBase64}}" class="logo" />
        {{/if}}
        <div class="school-info">
            <h2>{{schoolName}}</h2>
            <p>Versão da Prova: <strong>{{versionLabel}}</strong></p>
        </div>
    </div>

    <div class="student-info" style="margin-top: 15px; margin-bottom: 25px; display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
        <div style="display: flex; gap: 10px; align-items: flex-end;">
            <span style="font-weight: bold;">Aluno(a):</span>
            <div style="flex: 1; border-bottom: 1px solid #000; height: 18px;"></div>
            <span style="margin-left: 20px; font-weight: bold;">Data:</span>
            <div style="width: 100px; border-bottom: 1px solid #000; height: 18px;"></div>
        </div>
        <div style="display: flex; gap: 10px; align-items: flex-end;">
            <span style="font-weight: bold;">Professor(a):</span>
            <div style="flex: 1; border-bottom: 1px solid #000; height: 18px;"></div>
        </div>
    </div>

    <h2>Folha de Respostas - Versão {{versionLabel}} [cite: 85]</h2>

    <div class="gabarito-grid">
        {{#each questions}}
            <div class="gabarito-row">
                <span style="width: 20px;"><strong>{{this.position}}</strong></span>
                
                <div class="bubble">A</div>
                <div class="bubble">B</div>
                <div class="bubble">C</div>
                <div class="bubble">D</div>
                <div class="bubble">E</div>
            </div>
        {{/each}}
    </div>
</body>
</html>